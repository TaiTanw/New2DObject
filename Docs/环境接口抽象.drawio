        <mxCell id="sourceAccess" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:20px;font-weight:bold;color:#19354B;&quot;&gt;IEnvironmentSource&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;color:#19354B;margin-top:3px;&quot;&gt;环境源的接入协议&lt;/div&gt;&lt;div style=&quot;font-size:16px;color:#344F62;margin-top:10px;&quot;&gt;暴露 EnvironmentRegistration 属性。&lt;br&gt;当前 BasicPhysicalObject 实现；其他组件也可独立实现。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#F1F5FA;strokeColor=#9DB0C6;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=16;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="50" y="220" width="825" height="133" as="geometry" />
        </mxCell>
        <mxCell id="receiverAccess" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:20px;font-weight:bold;color:#19354B;&quot;&gt;IEnvironmentReceiver&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;color:#19354B;margin-top:3px;&quot;&gt;实体的接收协议&lt;/div&gt;&lt;div style=&quot;font-size:16px;color:#344F62;margin-top:10px;&quot;&gt;暴露 EntityEnvironmentContext 属性。&lt;br&gt;当前由 BasicEntity 实现；进入关系管理需要此入口。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#F1F5FA;strokeColor=#9DB0C6;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=16;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
