        <mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=0;strokeColor=#8294A5;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#3E586B;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.27;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="character" target="characterBase">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="remember1" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:20px;font-weight:bold;color:#19354B;&quot;&gt;本次改变的重点&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;color:#19354B;margin-top:3px;&quot;&gt;冰面不再自己维护三套清理流程&lt;/div&gt;&lt;div style=&quot;font-size:16px;color:#344F62;margin-top:10px;&quot;&gt;IceGround 保留“怎么计算参数”，公共逻辑负责“怎么登记、怎么解除”。&lt;br&gt;现有继承链仍在，旧子类也仍继承公共状态参数；能力接口本身不要求这条继承链。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#F8FAFC;strokeColor=#CDD7E0;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=16;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="45" y="1030" width="1060" height="151" as="geometry" />
        </mxCell>
        <mxCell id="remember2" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:20px;font-weight:bold;color:#19354B;&quot;&gt;继续阅读&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;color:#19354B;margin-top:3px;&quot;&gt;下一页看：对象是谁持有的&lt;/div&gt;&lt;div style=&quot;font-size:16px;color:#344F62;margin-top:10px;&quot;&gt;继承回答“公共代码来自哪里”。&lt;br&gt;持有关系回答“运行时数据放在哪里”。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#F8FAFC;strokeColor=#CDD7E0;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=16;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="1140" y="1030" width="615" height="151" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ownership" name="02 结构事实：对象与数据归属">
    <mxGraphModel dx="1800" dy="1390" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1390" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
