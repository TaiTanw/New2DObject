        <mxCell id="reader2" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;color:#19354B;&quot;&gt;进入时初始化；相位 3 持续控制与计算&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#344F62;margin-top:10px;&quot;&gt;Context 调用 AddForce，累计速度保存在实体。&lt;br&gt;ForceCalculation 更新控制参数，随后实体执行 ForceData 算法。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#ECF3FC;strokeColor=#8DAED4;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=15;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="1020" y="726" width="725" height="131" as="geometry" />
