        <mxCell id="cap3" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;color:#19354B;&quot;&gt;IGroundResponse&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;color:#19354B;margin-top:3px;&quot;&gt;支撑表面的响应参数&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#344F62;margin-top:10px;&quot;&gt;SlowingEffect、JumpHeightNum。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#F1F5FA;strokeColor=#9DB0C6;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=15;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="50" y="873" width="490" height="131" as="geometry" />
