        <mxCell id="reader0" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;color:#19354B;&quot;&gt;Context.SetAccess → StatePowerRegistration&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#344F62;margin-top:10px;&quot;&gt;登记到 BasicEntity.phyStateDic。&lt;br&gt;相位 3 求和、限幅，再用 1 + nowPhyNum 修饰主动速度。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#ECF3FC;strokeColor=#8DAED4;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=15;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
