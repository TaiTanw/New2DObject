          <mxGeometry x="45" y="24" width="1650" height="26" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="02 再看清：谁持有谁，数据究竟存在哪里" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=32;fontColor=#19354B;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="45" y="60" width="1710" height="48" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="这里的方框表示运行时对象或数据。每个环境源有自己的辅助对象，每个实体有自己的环境 Context。" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#546B7D;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="47" y="121" width="1700" height="35" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#254E67;strokeColor=#254E67;strokeWidth=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="171" width="1710" height="3" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="02 / 05    02 结构事实：对象与数据归属     ·     实线箭头上的文字说明关系；只有空心三角表示继承。" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#546B7D;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="45" y="1347" width="1710" height="24" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="环境源对象" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#19354B;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="70" y="207" width="450" height="33" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="受影响的实体对象" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#19354B;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="660" y="207" width="480" height="33" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="实体已经存在的数值存储" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#19354B;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1260" y="207" width="480" height="33" as="geometry" />
        </mxCell>
        <mxCell id="source" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:20px;font-weight:bold;color:#19354B;&quot;&gt;BasicPhysicalObject&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;color:#19354B;margin-top:3px;&quot;&gt;例如：场景中的一块冰面&lt;/div&gt;&lt;div style=&quot;font-size:16px;color:#344F62;margin-top:10px;&quot;&gt;通过 IEnvironmentSource 暴露接入辅助对象。&lt;br&gt;参数、特殊计算规则保留在具体组件上。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#EAF6F2;strokeColor=#87B7A7;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=16;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="70" y="260" width="450" height="150" as="geometry" />
        </mxCell>
        <mxCell id="entity" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:20px;font-weight:bold;color:#19354B;&quot;&gt;BasicEntity&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;color:#19354B;margin-top:3px;&quot;&gt;例如：角色或某一个箱子&lt;/div&gt;&lt;div style=&quot;font-size:16px;color:#344F62;margin-top:10px;&quot;&gt;通过 IEnvironmentReceiver 暴露环境 Context。&lt;br&gt;一个实体一份关系记录；各实体互不混存。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#ECF3FC;strokeColor=#8DAED4;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=16;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="660" y="260" width="480" height="150" as="geometry" />
        </mxCell>
        <mxCell id="registration" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:20px;font-weight:bold;color:#19354B;&quot;&gt;EnvironmentRegistration&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;color:#19354B;margin-top:3px;&quot;&gt;源端的登记辅助对象&lt;/div&gt;&lt;div style=&quot;font-size:16px;color:#344F62;margin-top:10px;&quot;&gt;Provider：指向实际能力提供者。&lt;br&gt;receivers：受影响 Context 的反向索引。&lt;br&gt;区域查询缓存：上次 / 本次重叠实体集合。&lt;br&gt;状态修饰与持续速度用它作为稳定来源键。&lt;br&gt;这里不保存累计速度，也不积分力。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#F2EFFA;strokeColor=#B0A0D0;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=16;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="70" y="510" width="450" height="225" as="geometry" />
        </mxCell>
        <mxCell id="context" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:20px;font-weight:bold;color:#19354B;&quot;&gt;EntityEnvironmentContext&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;color:#19354B;margin-top:3px;&quot;&gt;实体拥有的环境关系账本&lt;/div&gt;&lt;div style=&quot;font-size:16px;color:#344F62;margin-top:10px;&quot;&gt;bindings：按来源保存 Binding。&lt;br&gt;SetAccess：记录接入依据，按能力登记效果。&lt;br&gt;Detach / ReleaseAll：统一解除已登记效果。&lt;br&gt;RefreshGround：核对支撑并更新环境帧。&lt;br&gt;通过 IForceAction 操作实体原有容器。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#F2EFFA;strokeColor=#B0A0D0;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=16;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="660" y="510" width="480" height="225" as="geometry" />
        </mxCell>
        <mxCell id="stores" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;color:#19354B;&quot;&gt;BasicEntity 中的原有容器&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;color:#19354B;margin-top:3px;&quot;&gt;力与速度数值仍存放在这里&lt;/div&gt;&lt;div style=&quot;font-size:16px;color:#344F62;margin-top:10px;&quot;&gt;phyStateDic&lt;br&gt;  主动移速修饰，来源键是 Registration。&lt;br&gt;startSpeedDic&lt;br&gt;  持续速度，来源键也是 Registration。&lt;br&gt;dynamicForceDic&lt;br&gt;  ForceData：参数、类型、累计速度。&lt;br&gt;  动态来源键仍是冰面 / 力场等动态施力接口。&lt;br&gt;objectApplyingForce&lt;br&gt;  动态来源的遍历索引，不是第二份数值。&lt;br&gt;UnderForceList&lt;br&gt;  限时速度；仍按原有链路计算。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#FFF5E6;strokeColor=#D8B579;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=16;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="1260" y="260" width="480" height="475" as="geometry" />
        </mxCell>
        <mxCell id="e14" value="持有 1 个" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#607B90;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#3E586B;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="source" target="registration">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e15" value="持有 1 个" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#607B90;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#3E586B;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="entity" target="context">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16" value="区域 / 显式入口&lt;br&gt;调用 SetAccess" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#607B90;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#3E586B;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.32;exitDx=0;exitDy=0;entryX=0;entryY=0.32;entryDx=0;entryDy=0;" edge="1" parent="1" source="registration" target="context">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17" value="Track / Untrack&lt;br&gt;维护反向索引" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#607B90;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#3E586B;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.77;exitDx=0;exitDy=0;entryX=1;entryY=0.77;entryDx=0;entryDy=0;" edge="1" parent="1" source="context" target="registration">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e18" value="调用登记 / 撤销&lt;br&gt;更新原容器" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#607B90;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#3E586B;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.77;entryDx=0;entryDy=0;" edge="1" parent="1" source="context" target="stores">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n19" value="Context 内部的两种记录" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#19354B;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="70" y="805" width="1070" height="33" as="geometry" />
        </mxCell>
        <mxCell id="n20" value="关键区别：关系结束，速度不一定归零" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#19354B;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1260" y="805" width="480" height="33" as="geometry" />
        </mxCell>
        <mxCell id="binding" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;color:#19354B;&quot;&gt;Binding（Context 私有类）&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;color:#19354B;margin-top:3px;&quot;&gt;一份来源关系的登记记录&lt;/div&gt;&lt;div style=&quot;font-size:16px;color:#344F62;margin-top:10px;&quot;&gt;access：Ground / Region / Explicit 位标记。&lt;br&gt;一个来源可以同时有多种接入依据。&lt;br&gt;hasMovement、hasStateVelocity：登记过什么。&lt;br&gt;dynamicForce：已登记的动态施力来源。&lt;br&gt;只有最后一个接入依据消失，才统一撤销。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#F2EFFA;strokeColor=#B0A0D0;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=16;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="70" y="860" width="505" height="228" as="geometry" />
        </mxCell>
        <mxCell id="frame" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:20px;font-weight:bold;color:#19354B;&quot;&gt;EntityEnvironmentFrame&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;color:#19354B;margin-top:3px;&quot;&gt;本帧支撑面的三个采样值&lt;/div&gt;&lt;div style=&quot;font-size:16px;color:#344F62;margin-top:10px;&quot;&gt;slowingMultiplier：消退阻力倍率。&lt;br&gt;jumpHeightOffset：跳跃高度加成。&lt;br&gt;platformDelta：平台本帧世界位移。&lt;br&gt;由 Context 在相位 2 整体更新。&lt;br&gt;它不是“全部环境速度”的另一份容器。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#FFF5E6;strokeColor=#D8B579;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=16;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="630" y="860" width="510" height="228" as="geometry" />
        </mxCell>
        <mxCell id="tail" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;color:#19354B;&quot;&gt;ForceData.speedStacking&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;color:#19354B;margin-top:3px;&quot;&gt;已经取得的速度属于实体状态&lt;/div&gt;&lt;div style=&quot;font-size:16px;color:#344F62;margin-top:10px;&quot;&gt;解除环境绑定时调用 RemoveForce。&lt;br&gt;该调用把动态力切换为 fadeAway。&lt;br&gt;累计速度留在 dynamicForceDic 中继续衰减。&lt;br&gt;尾效归零后，再由实体原循环移除。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#FFF5E6;strokeColor=#D8B579;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=16;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="1260" y="860" width="480" height="228" as="geometry" />
        </mxCell>
        <mxCell id="e24" value="内部持有" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#607B90;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#3E586B;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="context" target="binding">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="780" y="780" />
              <mxPoint x="499.25" y="780" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e25" value="更新本帧采样" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#607B90;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#3E586B;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.72;exitY=1;exitDx=0;exitDy=0;entryX=0.72;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="context" target="frame">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="oneTruth" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:20px;font-weight:bold;color:#19354B;&quot;&gt;不要把两份“名单”误认为两份物理状态&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;color:#19354B;margin-top:3px;&quot;&gt;Context 是关系的权威记录；Registration 是清理用的反向索引&lt;/div&gt;&lt;div style=&quot;font-size:16px;color:#344F62;margin-top:10px;&quot;&gt;源禁用时，可以从反向索引找到所有受影响实体并解除绑定；实体退出时，也会同步从源端索引中移除自己。&lt;br&gt;两边没有各算一次速度。数字仍由实体原有容器保存，Context 负责统一接入、采样和清理。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#F8FAFC;strokeColor=#CDD7E0;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=16;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="70" y="1140" width="1670" height="153" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="lifecycle" name="03 运行事实：进入、保持与退出">
    <mxGraphModel dx="1800" dy="1440" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1440" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n1" value="环境接口抽象  /  第一阶段第二步 · 当前代码结构" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#546B7D;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="45" y="24" width="1650" height="26" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="03 沿着一次作用看：它怎样开始，又怎样结束" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=32;fontColor=#19354B;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="45" y="60" width="1710" height="48" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="进入环境，不等于每帧重新加一份力。接入关系负责保留一份效果，原速度算法负责逐帧计算。" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#546B7D;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="47" y="121" width="1700" height="35" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#254E67;strokeColor=#254E67;strokeWidth=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="171" width="1710" height="3" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="03 / 05    03 运行事实：进入、保持与退出     ·     实线箭头上的文字说明关系；只有空心三角表示继承。" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#546B7D;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="45" y="1397" width="1710" height="24" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="三个入口：发现“这个来源目前对这个实体有效”" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#19354B;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="50" y="207" width="1700" height="33" as="geometry" />
        </mxCell>
        <mxCell id="groundIn" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:20px;font-weight:bold;color:#19354B;&quot;&gt;Ground · 脚下支撑&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;color:#19354B;margin-top:3px;&quot;&gt;由实体相位 2 主动核对&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#344F62;margin-top:10px;&quot;&gt;BasicEntity.PhyFunUpdate&lt;br&gt;→ Context.RefreshGround(groundCollider)&lt;br&gt;找有效 IEnvironmentSource，且允许地面接入。&lt;br&gt;也在这里采样支撑参数；无需调用冰面 OnPhyEnter。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#EAF6F2;strokeColor=#87B7A7;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=15;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="50" y="260" width="535" height="184" as="geometry" />
        </mxCell>
        <mxCell id="regionIn" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:20px;font-weight:bold;color:#19354B;&quot;&gt;Region · 区域重叠&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;color:#19354B;margin-top:3px;&quot;&gt;由区域源相位 2 主动采样&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#344F62;margin-top:10px;&quot;&gt;BasicPhysicalObject.RefreshRegion&lt;br&gt;→ Registration.RefreshTriggerRegion()&lt;br&gt;多个源 / 接收 Collider 按实体取并集。&lt;br&gt;相位 2 查询替代各子类的 Enter / Exit 回调。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#EAF6F2;strokeColor=#87B7A7;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=15;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="633" y="260" width="535" height="184" as="geometry" />
        </mxCell>
        <mxCell id="explicitIn" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:20px;font-weight:bold;color:#19354B;&quot;&gt;Explicit · 显式进入 / 退出&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;color:#19354B;margin-top:3px;&quot;&gt;保留给外部调用的兼容入口&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#344F62;margin-top:10px;&quot;&gt;OnPhyEnter / OnPhyExit&lt;br&gt;→ Registration 的显式接入依据&lt;br&gt;只影响 Explicit 标记，不误删 Ground / Region。&lt;br&gt;重新接入时，由显式调用方再次通知进入。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#EAF6F2;strokeColor=#87B7A7;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=15;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="1216" y="260" width="535" height="184" as="geometry" />
        </mxCell>
        <mxCell id="access" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:20px;font-weight:bold;color:#19354B;&quot;&gt;Context.SetAccess&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;color:#19354B;margin-top:3px;&quot;&gt;先看这个来源有没有登记过&lt;/div&gt;&lt;div style=&quot;font-size:16px;color:#344F62;margin-top:10px;&quot;&gt;已有 Binding：只合并接入依据，不重复登记。&lt;br&gt;第一次进入：创建 Binding，记录来源。&lt;br&gt;随后按该来源实际实现的接口登记效果。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#F2EFFA;strokeColor=#B0A0D0;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=16;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="50" y="535" width="535" height="168" as="geometry" />
        </mxCell>
        <mxCell id="apply" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;color:#19354B;&quot;&gt;IForceAction · 实体写入入口&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;color:#19354B;margin-top:3px;&quot;&gt;三类效果写入原有容器&lt;/div&gt;&lt;div style=&quot;font-size:16px;color:#344F62;margin-top:10px;&quot;&gt;移速修饰 → StatePowerRegistration&lt;br&gt;持续速度 → AddSpeedStatus&lt;br&gt;动态施力 → CreateEnvironmentForce → AddForce&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#ECF3FC;strokeColor=#8DAED4;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=16;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="633" y="535" width="535" height="168" as="geometry" />
        </mxCell>
        <mxCell id="calculate" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;color:#19354B;&quot;&gt;BasicEntity · 相位 3&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;color:#19354B;margin-top:3px;&quot;&gt;这时才按原算法算速度&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#344F62;margin-top:10px;&quot;&gt;PhyStateCalculate：合并主动移速修饰。&lt;br&gt;HUnderForce：限时、动态和持续速度合成。&lt;br&gt;动态源回调 ForceCalculation，再更新 ForceData。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#ECF3FC;strokeColor=#8DAED4;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=15;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="1216" y="535" width="535" height="168" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#607B90;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#3E586B;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="groundIn" target="access">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#607B90;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#3E586B;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="regionIn" target="access">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="900.5" y="490" />
              <mxPoint x="317.5" y="490" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#607B90;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#3E586B;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="explicitIn" target="access">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1483.5" y="475" />
              <mxPoint x="478" y="475" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e16" value="首次登记" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#607B90;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#3E586B;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="access" target="apply">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-22" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e17" value="相位 3 消费" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#607B90;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#3E586B;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="apply" target="calculate">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-22" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n18" value="保持与退出：登记关系和累计速度分别处理" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#19354B;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="50" y="758" width="1700" height="33" as="geometry" />
        </mxCell>
        <mxCell id="stay" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:20px;font-weight:bold;color:#19354B;&quot;&gt;仍在作用范围内&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;color:#19354B;margin-top:3px;&quot;&gt;重复确认关系，持续计算效果&lt;/div&gt;&lt;div style=&quot;font-size:16px;color:#344F62;margin-top:10px;&quot;&gt;Ground / Region 每次采样都会确认接入。&lt;br&gt;因此原地重启后，也能重新建立已清理的绑定。&lt;br&gt;同一来源仍只登记一次。&lt;br&gt;重新进入动态环境：沿用旧 AddForce 规则，&lt;br&gt;保留累计速度和旧初始化参数，仅恢复 apply。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#F8FAFC;strokeColor=#CDD7E0;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=16;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="50" y="813" width="535" height="230" as="geometry" />
        </mxCell>
        <mxCell id="exit" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:20px;font-weight:bold;color:#19354B;&quot;&gt;最后一个接入依据消失&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;color:#19354B;margin-top:3px;&quot;&gt;Context.Detach 统一撤销&lt;/div&gt;&lt;div style=&quot;font-size:16px;color:#344F62;margin-top:10px;&quot;&gt;主动移速修饰 → 删除该来源。&lt;br&gt;持续速度 → 删除该来源。&lt;br&gt;动态施力 → RemoveForce → fadeAway。&lt;br&gt;Binding 删除，同时执行 Untrack。&lt;br&gt;已经取得的动态速度仍留在实体里衰减。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#F2EFFA;strokeColor=#B0A0D0;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=16;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="633" y="813" width="535" height="230" as="geometry" />
        </mxCell>
        <mxCell id="disabled" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:20px;font-weight:bold;color:#19354B;&quot;&gt;来源或实体被禁用&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;color:#19354B;margin-top:3px;&quot;&gt;双方都能发起完整清理&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#344F62;margin-top:10px;&quot;&gt;源 OnDisable → Registration.ReleaseAll。&lt;br&gt;实体 OnDisable → Context.ReleaseAll。&lt;br&gt;重复清理安全；来源销毁也会核对失效关系。&lt;br&gt;区域只剩一个 Collider 重叠时仍保持作用；&lt;br&gt;最后一个离开或删除，才解除区域依据。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#F8FAFC;strokeColor=#CDD7E0;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=15;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="1216" y="813" width="535" height="230" as="geometry" />
        </mxCell>
        <mxCell id="n22" value="放回整条物理管线：数字是实际物理相位" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#19354B;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="50" y="1090" width="1700" height="33" as="geometry" />
        </mxCell>
        <mxCell id="phase0" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;color:#19354B;&quot;&gt;0 · 平台运动&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#344F62;margin-top:10px;&quot;&gt;Taijie 更新自身位置&lt;br&gt;产出本帧 Delta&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#EAF6F2;strokeColor=#87B7A7;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=15;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="50" y="1145" width="263" height="134" as="geometry" />
        </mxCell>
        <mxCell id="phase1" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;color:#19354B;&quot;&gt;1 · 几何查询&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#344F62;margin-top:10px;&quot;&gt;真实 Collider / 法线&lt;br&gt;重置自身基础阻力&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#F8FAFC;strokeColor=#CDD7E0;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=15;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="337" y="1145" width="263" height="134" as="geometry" />
        </mxCell>
        <mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#607B90;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#3E586B;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="phase0" target="phase1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="phase2" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;color:#19354B;&quot;&gt;2 · 环境接入&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#344F62;margin-top:10px;&quot;&gt;支撑 / 区域关系核对&lt;br&gt;采样支撑环境帧&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#F2EFFA;strokeColor=#B0A0D0;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=15;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="624" y="1145" width="263" height="134" as="geometry" />
        </mxCell>
