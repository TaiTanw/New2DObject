        <mxCell id="provider0" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;color:#19354B;&quot;&gt;BasicPhysicalObject&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#344F62;margin-top:10px;&quot;&gt;所有旧环境子类继承这项能力。&lt;br&gt;读取旧字段 speedChangeNum。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#EAF6F2;strokeColor=#87B7A7;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=15;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
