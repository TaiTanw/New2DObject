          <mxGeometry x="1020" y="873" width="725" height="131" as="geometry" />
        </mxCell>
        <mxCell id="cap4" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;color:#19354B;&quot;&gt;IPlatformMotion&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;color:#19354B;margin-top:3px;&quot;&gt;支撑物本帧位移&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#344F62;margin-top:10px;&quot;&gt;Delta：世界位移，不是速度。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#F1F5FA;strokeColor=#9DB0C6;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=15;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="50" y="1020" width="490" height="131" as="geometry" />
        </mxCell>
        <mxCell id="provider4" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;color:#19354B;&quot;&gt;Taijie&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#344F62;margin-top:10px;&quot;&gt;沿用基类中的 Delta 存储。&lt;br&gt;相位 0 更新，支撑时读取。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#EAF6F2;strokeColor=#87B7A7;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=15;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="575" y="1020" width="410" height="131" as="geometry" />
        </mxCell>
        <mxCell id="reader4" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;color:#19354B;&quot;&gt;Context.RefreshGround → 环境帧 → 运动快照&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#344F62;margin-top:10px;&quot;&gt;platformDelta 在相位 2 采样。&lt;br&gt;相位 3 加入 EntityMotionFrame，一次计入预测与基础提交。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#ECF3FC;strokeColor=#8DAED4;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=15;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="1020" y="1020" width="725" height="131" as="geometry" />
        </mxCell>
        <mxCell id="cap5" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;color:#19354B;&quot;&gt;IWallSlideSurface&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;color:#19354B;margin-top:3px;&quot;&gt;墙滑能力与倍率&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#344F62;margin-top:10px;&quot;&gt;WallSlideMultiplier：下滑倍率。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#F1F5FA;strokeColor=#9DB0C6;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=15;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="50" y="1167" width="490" height="131" as="geometry" />
        </mxCell>
        <mxCell id="provider5" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:19px;font-weight:bold;color:#19354B;&quot;&gt;Wall&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#344F62;margin-top:10px;&quot;&gt;接口存在且组件有效，才有墙滑能力。&lt;br&gt;无脚本墙仍可作为几何障碍。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#EAF6F2;strokeColor=#87B7A7;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=15;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="575" y="1167" width="410" height="131" as="geometry" />
        </mxCell>
        <mxCell id="reader5" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;color:#19354B;&quot;&gt;EnvironmentCapabilities.Find → 角色物理层&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#344F62;margin-top:10px;&quot;&gt;BasePhysicsEntity 保存有效墙滑引用；CharacterPhysics 读取倍率。&lt;br&gt;逻辑层只读属性返回是否具有有效能力的布尔事实。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#ECF3FC;strokeColor=#8DAED4;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=15;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="1020" y="1167" width="725" height="131" as="geometry" />
        </mxCell>
        <mxCell id="legacy1" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;color:#19354B;&quot;&gt;仍保留的旧协议&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;color:#19354B;margin-top:3px;&quot;&gt;新接入层继续复用已有速度系统&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#344F62;margin-top:10px;&quot;&gt;IForceAction：实体登记、撤销与更新效果的写入方法。&lt;br&gt;IApplyingForceAction：旧显式进入 / 退出协议；Registration 也实现它。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#F8FAFC;strokeColor=#CDD7E0;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=15;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="50" y="1352" width="825" height="140" as="geometry" />
        </mxCell>
        <mxCell id="legacy2" value="&lt;div style=&quot;font-family:Microsoft YaHei;line-height:1.4;text-align:left;box-sizing:border-box;width:100%;padding:12px 14px;&quot;&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;color:#19354B;&quot;&gt;两个容易混淆的接口&lt;/div&gt;&lt;div style=&quot;font-size:18px;font-weight:bold;color:#19354B;margin-top:3px;&quot;&gt;能力和几何身份分别判断&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#344F62;margin-top:10px;&quot;&gt;ICanMove：移动方向 / 移动能力，供冰面按受力者计算参数。&lt;br&gt;IPhyBaseI：旧物理标记；不能代替真实 Collider 或具体能力。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;fillColor=#F8FAFC;strokeColor=#CDD7E0;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#19354B;fontSize=15;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
