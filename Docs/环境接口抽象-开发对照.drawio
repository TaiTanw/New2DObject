        <object id="step1" label="&lt;div style=&quot;box-sizing:border-box;padding:15px 17px;width:100%;font-family:Microsoft YaHei;line-height:1.45;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:21px;font-weight:bold;color:#193B51;&quot;&gt;ENV-02 · 先看三步目录，再进具体判断&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#365368;margin-top:9px;&quot;&gt;EntityEnvironmentContext.RefreshGround（核对脚下）&lt;br&gt;找来源 → 核对关系 → 采样参数。&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#56778E;margin-top:10px;&quot;&gt;P / Base/EntityEnvironmentContext.cs:134&lt;/div&gt;&lt;/div&gt;" link="../Assets/Script/Framworker/Function/Physics/Base/EntityEnvironmentContext.cs" tooltip="相对文件链接：Assets/Script/Framworker/Function/Physics/Base/EntityEnvironmentContext.cs。用框内方法名或 ENV 编号定位；链接打开方式取决于本机文件关联。">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;align=left;verticalAlign=top;fillColor=#F2EDFA;strokeColor=#A88EC7;strokeWidth=1.5;dashed=0;dashPattern=8 5;" vertex="1" parent="1">
            <mxGeometry x="45" y="465" width="855" height="157" as="geometry" />
          </mxCell>
