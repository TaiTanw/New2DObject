          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=fill;align=left;verticalAlign=top;fillColor=#EAF2FC;strokeColor=#7E9FC7;strokeWidth=1.5;dashed=0;dashPattern=8 5;" vertex="1" parent="1">
