          </mxCell>
        </object>
        <object id="submit" label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;5 · 实体提交一次 MovePosition&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;MonoPublicMgr → DisplacementCorrection。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;只消费 requestedWorldDelta，不再拼偏置或按帧初贴墙裁剪。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Base/BasicEntity.cs" tooltip="Assets/Script/Framworker/Function/Physics/Base/BasicEntity.cs · DisplacementCorrection">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#E8F5EE;strokeColor=#559A79;strokeWidth=1.5;">
            <mxGeometry x="40" y="3300" width="500" height="175" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="engine" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;请求之后的边界&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Dynamic 混合模式：请求位移不等于 Unity 最终实际落点。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;引擎推进后，下一帧相位 1 重新获得几何事实；观测只复制数据，不参与解算。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;成本：最多首轮加两轮环境请求；接触对扫描按实体数量的平方增长。&lt;/div&gt;&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#F7F9FC;strokeColor=#B5BFCD;strokeWidth=1.5;">
          <mxGeometry x="620" y="3300" width="1840" height="175" as="geometry" />
        </mxCell>
