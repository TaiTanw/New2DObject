        <object id="force-calc" label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;有效接触与水平施力&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;原预测确定接触轴与双方方向；最终请求终点必须仍贴合、竖直重叠且无深度嵌入。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;TryApplyHorizontalContactForce 读取同帧 motionVelocity.x，排除无相对闭合的接触。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;施力方向上双方均未被环境阻挡才登记；平台携带不作为自身施力速度。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;RegisterDirectedContactForce 更新 source → receiver；新关系汇总施力者衰减请求。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Mgr/PhysicsSolverMgr.cs" tooltip="Assets/Script/Framworker/Function/Physics/Mgr/PhysicsSolverMgr.cs · TryApplyHorizontalContactForce">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#F2EDFA;strokeColor=#9775BB;strokeWidth=1.5;">
            <mxGeometry x="620" y="2290" width="700" height="275" as="geometry" />
          </mxCell>
        </object>
        <object id="force-e" label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;receiver.SetOrUpdateDynamicForce&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;实体转交 EntityEffectState：刷新 ForceData 参数与 apply 类型，保留既有 speedStacking。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;本帧登记参数，下一帧相位 3 才积分。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Base/BasicEntity.cs" tooltip="Assets/Script/Framworker/Function/Physics/Base/BasicEntity.cs · SetOrUpdateDynamicForce">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#E8F5EE;strokeColor=#559A79;strokeWidth=1.5;">
