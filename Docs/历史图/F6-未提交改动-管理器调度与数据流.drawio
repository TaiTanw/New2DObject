        </mxCell>
        <object id="env" label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;4.2 · ResolveEnvironmentRequests&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;逐实体按顺序调用：&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;① ProbeCandidateEnvironment&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;② FinalizeRequestedDisplacement&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;首轮及每轮反馈结束后复用。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Mgr/PhysicsSolverMgr.cs" tooltip="Assets/Script/Framworker/Function/Physics/Mgr/PhysicsSolverMgr.cs · ResolveEnvironmentRequests">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#EAF1FC;strokeColor=#6086B9;strokeWidth=1.5;">
            <mxGeometry x="40" y="1320" width="500" height="215" as="geometry" />
          </mxCell>
        </object>
        <object id="probe" label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;ProbeCandidateEnvironment · 管理器直接调用&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;候选终点由基础预测和累计接触偏置组成。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;清空并复用缓存：路径扫掠、终点重叠、脚下回扫；过滤自身及其他实体。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;记录单向平台身份；最后在内部调用 ResolveCandidateEnvironment。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Base/BasicEntity.cs" tooltip="Assets/Script/Framworker/Function/Physics/Base/BasicEntity.cs · ProbeCandidateEnvironment">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#E8F5EE;strokeColor=#559A79;strokeWidth=1.5;">
            <mxGeometry x="1400" y="1300" width="1060" height="205" as="geometry" />
          </mxCell>
        </object>
        <object id="resolve" label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:19px&quot;&gt;ResolveCandidateEnvironment · Probe 内部调用&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;先找可爬坡支撑，再依据其他路径命中缩短允许 X。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;X 被限制时，只在受限终点重查额外坡面 Y。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;零距离接触区分向内进入与向外离开。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Base/BasicEntity.cs" tooltip="Assets/Script/Framworker/Function/Physics/Base/BasicEntity.cs · ResolveCandidateEnvironment">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#E8F5EE;strokeColor=#559A79;strokeWidth=1.5;">
            <mxGeometry x="1400" y="1560" width="500" height="225" as="geometry" />
          </mxCell>
        </object>
        <object id="slope" label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:19px&quot;&gt;FindSlopeRise · Resolve 内部调用&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;原候选终点查一次；X 被缩短且仍非零时再查。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;筛选坡角、上坡方向与单向通行；选择有效的最大额外抬升。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;不是整帧总 Y；最高候选受阻时返回零。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Base/BasicEntity.cs" tooltip="Assets/Script/Framworker/Function/Physics/Base/BasicEntity.cs · FindSlopeRise">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#E8F5EE;strokeColor=#559A79;strokeWidth=1.5;">
            <mxGeometry x="1960" y="1560" width="500" height="225" as="geometry" />
          </mxCell>
        </object>
        <object id="lift" label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:19px&quot;&gt;HasLiftObstacle · FindSlopeRise 内部调用&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;有支撑时检查额外抬升净空；必要时调用 IsOneWayPassThrough。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;单向通行判断也用于水平路径与顶面筛选。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Base/BasicEntity.cs" tooltip="Assets/Script/Framworker/Function/Physics/Base/BasicEntity.cs · HasLiftObstacle">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#E8F5EE;strokeColor=#559A79;strokeWidth=1.5;">
            <mxGeometry x="1960" y="1840" width="500" height="155" as="geometry" />
          </mxCell>
        </object>
        <object id="final" label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;FinalizeRequestedDisplacement · 管理器随后调用&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;合成最终请求：允许 X、保留的原沿坡 Y、独立垂直位移、平台位移、实体 Y 纠偏与环境抬升。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;本次抖动修复：坡面 Y 按原自身 X 的保留比例同步缩短，涵盖接触纠偏与环境裁剪。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;复用路径命中限制撞顶的整段请求，记录最终 X 阻挡方向；不再查询、不移动。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Base/BasicEntity.cs" tooltip="Assets/Script/Framworker/Function/Physics/Base/BasicEntity.cs · FinalizeRequestedDisplacement">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#E8F5EE;strokeColor=#559A79;strokeWidth=1.5;">
            <mxGeometry x="1400" y="2050" width="1060" height="235" as="geometry" />
          </mxCell>
        </object>
