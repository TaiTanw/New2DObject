        <object id="clear" label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;4.4 · 清理最终受阻速度&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;逐实体调用 ClearTransientSpeedForFinalBlock。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;完成全部反馈后才执行。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Mgr/PhysicsSolverMgr.cs" tooltip="Assets/Script/Framworker/Function/Physics/Mgr/PhysicsSolverMgr.cs · ContactForSolution">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#EAF1FC;strokeColor=#6086B9;strokeWidth=1.5;">
