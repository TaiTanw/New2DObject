        <object id="feedback" label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;4.3 · ResolveResidualHorizontalOverlaps&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;管理器直接检查请求终点的残余水平重叠。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;一轮累加偏置，轮末统一重新求环境；最多两轮。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Mgr/PhysicsSolverMgr.cs" tooltip="Assets/Script/Framworker/Function/Physics/Mgr/PhysicsSolverMgr.cs · ResolveResidualHorizontalOverlaps">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#EAF1FC;strokeColor=#6086B9;strokeWidth=1.5;">
            <mxGeometry x="40" y="1740" width="500" height="180" as="geometry" />
          </mxCell>
        </object>
        <object id="feedback-calc" label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;残余水平反馈 · 本次新增步骤&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;用原预测框还原当前中心，再加 RequestedWorldDelta。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;仅处理超过容差、竖直仍重叠且适合沿 X 分离的接触。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;朝退出方向已被环境挡住的一侧权重置零；其余按 EnvImpact 分担。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;双方权重都不足则跳过；否则调用 A / B.AccumulateDisplacementOffset。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;同轮其他接触仍读取轮初请求；有新增纠偏才回调 ResolveEnvironmentRequests。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;无新增纠偏提前结束；两轮上限不保证任意箱链收敛。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Mgr/PhysicsSolverMgr.cs" tooltip="Assets/Script/Framworker/Function/Physics/Mgr/PhysicsSolverMgr.cs · ResolveResidualHorizontalOverlaps">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#F2EDFA;strokeColor=#9775BB;strokeWidth=1.5;">
            <mxGeometry x="620" y="1690" width="700" height="330" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="edge-14" value="展开" edge="1" parent="1" source="feedback" target="feedback-calc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#9775BB;fontColor=#344155;fontSize=16;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;">
