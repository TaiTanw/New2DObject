        <object id="first" label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;4.1 · 首轮预测重叠纠偏&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;遍历不重复实体对；基于原预测框累加偏置。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;本轮预测快照不被改写。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Mgr/PhysicsSolverMgr.cs" tooltip="Assets/Script/Framworker/Function/Physics/Mgr/PhysicsSolverMgr.cs · ContactForSolution">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#EAF1FC;strokeColor=#6086B9;strokeWidth=1.5;">
            <mxGeometry x="40" y="1050" width="500" height="155" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="first-calc" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;首轮实体间解算&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;两轴都重叠才处理；选择重叠深度较小的轴（相等选 X）。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;扣除 ContactSlop，再按双方非负 EnvImpact 比例分担。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;A / B 沿相反方向挤出；首轮可产生 X 或 Y 偏置。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;只有几何纠偏，此时不登记接触力、不移动刚体。&lt;/div&gt;&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#263449;fillColor=#F2EDFA;strokeColor=#9775BB;strokeWidth=1.5;">
          <mxGeometry x="620" y="1030" width="700" height="235" as="geometry" />
        </mxCell>
        <object id="acc" label="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;AccumulateDisplacementOffset&lt;/b&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;管理器 → A / B：累加本帧实体纠偏。&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;只修改 EntitySolutionResult.displacementOffset。&lt;/div&gt;&lt;/div&gt;" link="../../Assets/Script/Framworker/Function/Physics/Base/BasicEntity.cs" tooltip="Assets/Script/Framworker/Function/Physics/Base/BasicEntity.cs · AccumulateDisplacementOffset">
