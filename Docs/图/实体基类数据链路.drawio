<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" modified="2026-10-21T00:00:00.000Z" version="24.7.17" type="device" pages="1">
  <diagram id="entity-dataflow" name="BasicEntity 数据链路与字段分类">
    <mxGraphModel dx="2040" dy="2860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2040" pageHeight="2860" math="0" shadow="0" background="#f8fafc">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="refs" value="&lt;b style=&quot;font-size:20px&quot;&gt;A · 组件 / 资源 / 探针引用&lt;/b&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;rb：刚体；实际位置、速度跨步保存在 Unity 中&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;boxCollider：本实体碰撞框&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;cPhysics：物理配置资源（层、坡度、探针尺寸等）&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;groundV / leftV / rightV / upV：探针 Transform&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;用途：相位 1 查询、相位 3 写入、相位 5 回读&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=16;spacingTop=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#173f73;fillColor=#eef5ff;strokeColor=#93b7e5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="42" y="204" width="630" height="202" />
        </mxCell>
        <mxCell id="config" value="&lt;b style=&quot;font-size:20px&quot;&gt;B · 参数 / 参与状态 / 全局登记&lt;/b&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;gravity：重力加速度；Awake 乘 airResistance&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;envImpact：环境影响；horizontalAcceleration：驱动加速度&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;self_resistanceCoefficient：本步采样并应用地面倍率&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;motionParticipation：实体许可；worldPaused：静态暂停状态&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;activeEntities：启用实体集合，具有全局登记语义&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=16;spacingTop=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#173f73;fillColor=#eef5ff;strokeColor=#93b7e5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="42" y="430" width="630" height="202" />
        </mxCell>
        <mxCell id="cross" value="&lt;b style=&quot;font-size:20px&quot;&gt;C · 真正影响下一步的跨帧分量&lt;/b&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;acceptedPrescribedVelocity：模拟实际接受的附加分量&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;activeHorizontalVelocity：主动水平分量，模拟后校正&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;下一步从 rb.velocity 扣掉两者，分离剩余惯性&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;commandedVerticalSpeed：自身竖直意图，参与下一步判断&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;这些量用于分量归属；不是独立保存的另一份总动量&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;动态力来源退出后，惯性继续由刚体实际速度承载&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=16;spacingTop=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#146247;fillColor=#eaf8f1;strokeColor=#78bea0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="42" y="656" width="630" height="228" />
        </mxCell>
        <mxCell id="step" value="&lt;b style=&quot;font-size:20px&quot;&gt;D · 本步命令记录（从相位 3 保留到 4 / 5）&lt;/b&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;plannedVelocity：相位 3 地形处理后的计划；侧推读取&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;submittedVelocity：提交值；相位 4 可改水平分量&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;prescribedVelocity：附加命令；裁剪 / 侧推可修正&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;requestOrigin：本步模拟前刚体位置，用于位移观测&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;hasMotionCommand：本步有效标记，回读后清除&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;它们虽是成员字段，主要服务同一固定步&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;本步计划不等于碰撞后实际结果&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=16;spacingTop=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#80501d;fillColor=#fff4e5;strokeColor=#dfb471;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="42" y="908" width="630" height="254" />
        </mxCell>
        <mxCell id="scratch" value="&lt;b style=&quot;font-size:20px&quot;&gt;E · 可复用查询容器（主要减少临时分配）&lt;/b&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;groundProbeHits：脚下探针命中&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;nativeContacts：上次模拟留下的原生接触点&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;regionOverlapHits：区域查询原始命中&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;terrainHits：墙 / 坡 / 头顶的多次扫掠工作区&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;walkingRestoreHits：恢复实心时的重叠检查&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;使用前 Clear；保留容量，旧条目不承载惯性&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;容量增长仍可能分配；并非承诺全链零 GC&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=16;spacingTop=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#5b687a;fillColor=#f1f3f6;strokeColor=#bdc7d3;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="42" y="1186" width="630" height="254" />
        </mxCell>
        <mxCell id="observation" value="&lt;b style=&quot;font-size:20px&quot;&gt;F · 观测 / 生命周期 / 借用视图&lt;/b&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;lastDisplacementObservation：最近完成步的位移记录&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;displacementStep：观测序号；hasDisplacementObservation：有效&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;MotionRefreshVersion：显式刷新 / 安置的版本&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;oneWayDropColliders：借用子类 passingOneWays 的只读视图&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;passingOneWays 保存跨帧穿越状态，不是查询缓存&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;GroundProbeDistance：常量；不属于跨帧运行状态&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=16;spacingTop=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#514078;fillColor=#f2edff;strokeColor=#bba5e2;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="42" y="1464" width="630" height="228" />
        </mxCell>
        <mxCell id="phase0" value="&lt;b style=&quot;font-size:20px&quot;&gt;入口 · 调度 / 子类 / 模式&lt;/b&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;Player / FSM 给出动作意图，子类提供移动规则&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;相位 0：平台 / 水体更新后同步几何&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=16;spacingTop=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#173f73;fillColor=#eef5ff;strokeColor=#93b7e5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="742" y="204" width="600" height="124" />
        </mxCell>
        <mxCell id="phase1" value="&lt;b style=&quot;font-size:20px&quot;&gt;相位 1 · GeometricQueryPhase&lt;/b&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;子类探针 → SampleNativeContacts → 区域重叠&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;写 nowGemetry：接触、法线、区域事实&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;原生接触属于上次模拟；区域附带采样位置与速度&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;命中工作列表（E）→ 筛选后的几何事实（G）&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=16;spacingTop=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#173f73;fillColor=#eef5ff;strokeColor=#93b7e5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="742" y="364" width="600" height="176" />
        </mxCell>
        <mxCell id="phase2" value="&lt;b style=&quot;font-size:20px&quot;&gt;相位 2 · PhyFunUpdate&lt;/b&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;Context 核对脚下 / 区域来源：登记、刷新、撤销&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;效果数值写入 EffectState，不在 Context 积分速度&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;生成 EnvironmentFrame / WaterFrame&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;自身基础阻力 × slowingMultiplier&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=16;spacingTop=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#173f73;fillColor=#eef5ff;strokeColor=#93b7e5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="742" y="576" width="600" height="176" />
        </mxCell>
        <mxCell id="passive" value="&lt;b style=&quot;font-size:20px&quot;&gt;相位 3a · 读取真实速度 → 被动计算&lt;/b&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;free = rb.velocity − acceptedPrescribedVelocity&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;有水平驱动时，再扣 activeHorizontalVelocity&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;局部 passiveVelocityX = free.x&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;动态来源依次作用 → 自身阻力统一趋零一次&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;局部 plannedPassiveVelocityX；不借物理输出作工作区&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=16;spacingTop=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#146247;fillColor=#eaf8f1;strokeColor=#78bea0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="742" y="788" width="600" height="202" />
        </mxCell>
        <mxCell id="compose" value="&lt;b style=&quot;font-size:20px&quot;&gt;相位 3b · 合成 / 地形处理 / 提交&lt;/b&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;刷新 nowPhyNum、phyHSpeed / phyVSpeed&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;水平钩子返回目标；PhyEventUpdate(ref step)&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;VUnderForce → VActiveSpeedOperation(ref step)&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;OwnVelocity：本步自身候选，不写公开 H / V 速度&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;prescribed：状态 / 限时 + 平台 + 下坡贴合&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;submitted = step.OwnVelocity + prescribed&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;静墙裁剪、上坡实际抬升、头顶裁剪&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;保存计划与起点 → rb.velocity → Report(this)&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=16;spacingTop=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#80501d;fillColor=#fff4e5;strokeColor=#dfb471;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="742" y="1026" width="600" height="254" />
        </mxCell>
        <mxCell id="phase4" value="&lt;b style=&quot;font-size:20px&quot;&gt;相位 4 → 全局模拟屏障&lt;/b&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;EntitySidePush 按计划协调直接侧面的第一只实体&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;CommitHorizontal 可改提交量及相关分量&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;全部回调后 Physics2D.Simulate(dt)，整个世界一次&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=16;spacingTop=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#146247;fillColor=#eaf8f1;strokeColor=#78bea0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="742" y="1316" width="600" height="150" />
        </mxCell>
        <mxCell id="phase5" value="&lt;b style=&quot;font-size:20px&quot;&gt;相位 5 · DisplacementCorrection&lt;/b&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;读取 rb.velocity / rb.position 的真实结果&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;AcceptedComponent 校正实际接受的附加 / 主动分量&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;写 PlayerPhysicsData 的模拟后结果&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;更新位移观测；hasMotionCommand = false&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;下一步重新从刚体实际速度出发&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=16;spacingTop=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#146247;fillColor=#eaf8f1;strokeColor=#78bea0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="742" y="1502" width="600" height="190" />
        </mxCell>
        <mxCell id="geometry" value="&lt;b style=&quot;font-size:20px&quot;&gt;G · 几何事实快照 / 持久对象复用&lt;/b&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;nowGemetry 对象长期持有；内容按采样更新&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;ground / leftWall / rightWall Collider：接触身份&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;isGrounded / istop / onLeftWall / onRightWall&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;groundNormal：脚下法线&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;regionOverlaps：本步有效区域，供相位 2 消费&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;regionBodyBounds / regionBodyVelocity：同次采样&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;regionOverlaps 复用容量，但它同时是跨相位事实&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=16;spacingTop=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#173f73;fillColor=#eef5ff;strokeColor=#93b7e5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1412" y="204" width="586" height="254" />
        </mxCell>
        <mxCell id="context" value="&lt;b style=&quot;font-size:20px&quot;&gt;H · EnvironmentContext：关系状态 + 采样&lt;/b&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;environmentContext：实体持有的关系管理对象&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;bindings：跨帧登记单；退出时知道撤销什么&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;Frame：slowingMultiplier / jumpHeightOffset&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;       / platformDelta（本步平台位移）&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;WaterFrame：本步水事实，供行为 / 执行使用&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;currentSources：本次去重事实；removalBuffer：工作区&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;后两者复用容量，不是第二份长期来源关系&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=16;spacingTop=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#514078;fillColor=#f2edff;strokeColor=#bba5e2;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1412" y="482" width="586" height="254" />
        </mxCell>
        <mxCell id="effect" value="&lt;b style=&quot;font-size:20px&quot;&gt;I · EffectState：有效效果参数 / 限时命令&lt;/b&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;effectState：实体持有；receiver 回指受影响实体&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;movementModifiers：移速修饰；stateVelocities：状态速度&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;timedSpeeds：到期前有效的限时水平速度&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;dynamicForces：来源参数 / 类型，不存累计动量&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;isRecalculate：移速修饰的脏标记&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;forceSources：每次复制键的工作列表，回调可修改来源&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;字典与 timedSpeeds 有状态；不是单纯为避免 GC&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=16;spacingTop=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#514078;fillColor=#f2edff;strokeColor=#bba5e2;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1412" y="760" width="586" height="254" />
        </mxCell>
        <mxCell id="locals" value="&lt;b style=&quot;font-size:20px&quot;&gt;J · 只在本次调用有效的局部值&lt;/b&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;MotionStep：本次调用工作结构，不是跨帧容器&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;OwnVelocity：自身候选，由 ref 钩子显式传递&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;actual / free：读取与分离的速度&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;passiveVelocityX / passiveDeltaX / plannedPassiveVelocityX&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;targetHorizontalSpeed / tangent / slopeCarryX / slopeVertical&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;dt / delta / rise / writtenOwnY 等：不保留到下一步&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;float / Vector2 是值类型；设置局部量主要为语义清楚&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=16;spacingTop=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#5b687a;fillColor=#f1f3f6;strokeColor=#bdc7d3;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1412" y="1038" width="586" height="228" />
        </mxCell>
        <mxCell id="derived" value="&lt;b style=&quot;font-size:20px&quot;&gt;K · 派生入口 / 只读包装（不是新副本）&lt;/b&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;BasePhysicsEntity：主动水平驱动、墙能力、单向穿越&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;CharacterPhysics：角色动作 / 游泳等规则&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;PhysicalBox：箱体的几何与基础参数&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;ReadOnly_* 包装引用原数据，并非冻结的历史快照&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;PhysicsWorld / EnvironmentFrame / BodyBounds 是属性&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=16;spacingTop=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#173f73;fillColor=#eef5ff;strokeColor=#93b7e5;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1412" y="1290" width="586" height="202" />
        </mxCell>
        <mxCell id="modes" value="&lt;b style=&quot;font-size:20px&quot;&gt;旁路与运行门槛&lt;/b&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;不可参与 / Kinematic：不走普通积分链&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;穿墙飞行：直接写四向速度，清附加分量&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;零输入悬停；普通环境、坡面合成不进入&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;Refresh / Disable 会清有效标记并按规则撤销关系&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=16;spacingTop=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#5b687a;fillColor=#f1f3f6;strokeColor=#bdc7d3;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1412" y="1516" width="586" height="176" />
        </mxCell>
        <mxCell id="velocity3" value="&lt;b style=&quot;font-size:20px&quot;&gt;相位 3：先做工作值，再合成本步计划&lt;/b&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;targetHorizontalSpeed：HActiveSpeedOperation 返回目标&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;step.OwnVelocity.x：被动水平结果 + 主动分量&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;HasHorizontalDrive 保留；无驱动不同于目标为零&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;phyHSpeed：此时只汇总状态速度 X + 有效限时速度&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;step.OwnVelocity.y：分离实际速度 → 动作事件 → 重力 → 竖直规则&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;phyVSpeed：此时是状态速度 Y（限时速度只有 X）&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;step.OwnVelocity + prescribed 形成提交量，含平台与坡面项&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;普通运动不写 horizontalSpeed / verticalSpeed；飞行发布，刷新清零&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;nowPhyNum：移速修饰汇总；jumpSequence：消费跳跃时递增&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=16;spacingTop=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#80501d;fillColor=#fff4e5;strokeColor=#dfb471;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="42" y="1780" width="950" height="332" />
        </mxCell>
        <mxCell id="velocity5" value="&lt;b style=&quot;font-size:20px&quot;&gt;相位 5：覆盖为模拟后分量（角色与箱体也有差异）&lt;/b&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;有水平驱动：horizontalSpeed = 实际接受的主动水平分量&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;无水平驱动：horizontalSpeed = actual.x − acceptedPrescribedVelocity.x&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;phyHSpeed = actual.x − horizontalSpeed&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;因此角色的 phyHSpeed 包含惯性等剩余量；不再仅是状态命令&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;verticalSpeed = actual.y − acceptedPrescribedVelocity.y&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;无自身上升命令且着地时，正的自身竖直残余可被清除&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;phyVSpeed = acceptedPrescribedVelocity.y&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;水平字段相加还原 actual.x；竖直存在着地规则修正&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;不要用“主动 / 被动”旧注释跨阶段解释所有字段&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=16;spacingTop=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#883f38;fillColor=#fff0ef;strokeColor=#dea5a0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1024" y="1780" width="974" height="332" />
        </mxCell>
        <mxCell id="loop" value="&lt;b style=&quot;font-size:20px&quot;&gt;跨帧闭环：真实动量只有一个依据，分量记录用于避免重复叠加&lt;/b&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;本步模拟结果 rb.velocity → 相位 5 校正 acceptedPrescribedVelocity / activeHorizontalVelocity → 下一步相位 3 分离惯性&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;下一步重新汇总状态 / 限时 / 平台命令；动态力来源退出后，已经获得的实际惯性保留并受自身阻力影响&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;plan / submitted / prescribed 是命令，rb.velocity 是实际；碰撞可能使两者不同&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;AcceptedComponent 按提交量与实际量分摊接受分量，并非 Unity 返回的逐来源精确分解&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;不要把 lastDisplacementObservation、命中 List 或旧 phyHSpeed 当成另一个待恢复的动量容器&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=16;spacingTop=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#146247;fillColor=#eaf8f1;strokeColor=#78bea0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="42" y="2144" width="1956" height="202" />
        </mxCell>
        <mxCell id="lifecycle" value="&lt;b style=&quot;font-size:20px&quot;&gt;生命周期与读图边界&lt;/b&gt;&lt;div style=&quot;height:5px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;Awake：绑定 receiver，取得刚体 / 碰撞框，创建几何与物理数据；设置脚本重力和原生碰撞模式&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;OnEnable：加入 activeEntities，订阅相位 1 / 2 / 3 / 5；EntitySidePush 订阅相位 4&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;RefreshMotionState：增加版本，清运动分量 / 观测有效标记，清限时命令；可选撤销环境，恢复刚体并重采样&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;OnDisable：移除全局登记与侧推登记，取消相位订阅，释放环境关系；不等于所有字段自动变成有效的零值&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:26px&quot;&gt;图中分类按当前用途；同一对象长期存在，不代表其中每个字段都应作为跨帧物理状态使用&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=16;spacingTop=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243247;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="42" y="2378" width="1956" height="202" />
        </mxCell>
        <mxCell id="edge-0" source="phase0" target="phase1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#71849b;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge-1" source="phase1" target="phase2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#71849b;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge-2" source="phase2" target="passive" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#71849b;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge-3" source="passive" target="compose" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#71849b;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge-4" source="compose" target="phase4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#71849b;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge-5" source="phase4" target="phase5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#71849b;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge-6" source="phase5" target="passive" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#71849b;strokeWidth=2;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1376" y="1597" />
              <mxPoint x="1376" y="889" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="label-0" value="CODE MAP  /  2026-10-21  /  当前实现，水平目标与本步候选速度分离（单元 1–2）" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#687c93;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="42" y="22" width="1968" height="24" />
        </mxCell>
        <mxCell id="label-1" value="BasicEntity：从环境事实到刚体实际结果" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Microsoft YaHei;fontSize=36;fontColor=#182c45;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="42" y="55" width="1968" height="44" />
        </mxCell>
        <mxCell id="label-2" value="中列顺序阅读；两侧按数据职责分类。字段存活时间 ≠ 数据有效时间，集合类型 ≠ 临时缓存。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#526176;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="42" y="108" width="1968" height="28" />
        </mxCell>
        <mxCell id="label-3" value="字段归属与生命周期" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#182c45;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="42" y="153" width="1968" height="32" />
        </mxCell>
        <mxCell id="label-4" value="实体主干 · 一个固定步" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#182c45;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="742" y="153" width="1268" height="32" />
        </mxCell>
        <mxCell id="label-5" value="依赖对象与易混淆字段" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#182c45;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1412" y="153" width="598" height="32" />
        </mxCell>
        <mxCell id="label-6" value="最容易混淆：PlayerPhysicsData 是可变复用对象，字段在不同阶段承担不同角色" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Microsoft YaHei;fontSize=25;fontColor=#883f38;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="42" y="1725" width="1968" height="33" />
        </mxCell>
        <mxCell id="label-7" value="图例：蓝＝引用 / 参数 / 事实　绿＝跨帧接受量 / 原生结果　橙＝本步命令　紫＝关系 / 效果 / 观测　灰＝工作缓存 / 局部量" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#526176;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="42" y="2620" width="1968" height="26" />
        </mxCell>
        <mxCell id="label-8" value="特别区分：bindings / stateVelocities / timedSpeeds / passingOneWays 有有效状态；命中列表 / forceSources / removalBuffer 复用工作容量。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#526176;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="42" y="2662" width="1968" height="26" />
        </mxCell>
        <mxCell id="label-9" value="坡面说明：下坡按切线补向下速度；上坡由几何查询补实际抬升。maxClimbAngle 与着地固定 0.7 阈值尚非统一入口。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#526176;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="42" y="2704" width="1968" height="26" />
        </mxCell>
        <mxCell id="label-10" value="代码主入口：Assets/Script/Framworker/Function/Physics/Component/PlayerOBJ/base/BasicEntity.cs" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#526176;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="42" y="2746" width="1968" height="26" />
        </mxCell>
        <mxCell id="label-11" value="调整记录：Docs/开发日志.md · K002 / K003　｜　可编辑源：Docs/图/实体基类数据链路.drawio" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#526176;fontStyle=0;" vertex="1" parent="1">
